{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Speculators Eval Results",
  "type": "object",
  "required": ["updated_at", "baselines", "models"],
  "properties": {
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "baselines": {
      "type": "object",
      "description": "Autoregressive throughput baselines keyed by target model ID",
      "additionalProperties": { "$ref": "#/$defs/baseline" }
    },
    "models": {
      "type": "array",
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "baseline": {
      "type": "object",
      "description": "Throughput per GPU config for a target model without a drafter",
      "additionalProperties": {
        "type": "number",
        "description": "Throughput in tokens/sec for this GPU config"
      },
      "minProperties": 1
    },
    "model": {
      "type": "object",
      "required": [
        "model",
        "target",
        "algorithm",
        "num_speculative_tokens",
        "hf_last_modified",
        "evaluated_at",
        "gpus",
        "status",
        "metrics",
        "error",
        "deploy"
      ],
      "properties": {
        "model": { "type": "string" },
        "target": { "type": "string" },
        "algorithm": { "type": "string" },
        "num_speculative_tokens": { "type": "integer", "minimum": 1 },
        "hf_last_modified": { "type": "string", "format": "date-time" },
        "evaluated_at": { "type": "string", "format": "date-time" },
        "gpus": { "type": "string" },
        "status": { "type": "string", "enum": ["ok", "failed"] },
        "metrics": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/metrics" }
          ]
        },
        "error": {
          "oneOf": [
            { "type": "null" },
            { "type": "string" }
          ]
        },
        "deploy": { "$ref": "#/$defs/deploy" }
      },
      "additionalProperties": false
    },
    "deploy": {
      "type": "object",
      "required": ["command", "recipe_source", "recipe_model"],
      "properties": {
        "command": { "type": "string" },
        "recipe_source": { "type": "string" },
        "recipe_model": { "type": "string" }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": [
        "acceptance_length",
        "acceptance_at_pos",
        "num_drafts",
        "throughput_tps",
        "speedup",
        "ttft_ms",
        "itl_ms",
        "subsets"
      ],
      "properties": {
        "acceptance_length": { "type": "number" },
        "acceptance_at_pos": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 1
        },
        "num_drafts": { "type": "integer", "minimum": 0 },
        "throughput_tps": { "type": "number" },
        "speedup": { "type": "number" },
        "ttft_ms": { "type": "number" },
        "itl_ms": { "type": "number" },
        "subsets": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/subset" },
          "minProperties": 1
        }
      },
      "additionalProperties": false
    },
    "subset": {
      "type": "object",
      "required": [
        "acceptance_length",
        "acceptance_at_pos",
        "num_drafts",
        "num_draft_tokens",
        "num_accepted_tokens",
        "throughput_tps",
        "speedup",
        "ttft_ms",
        "itl_ms"
      ],
      "properties": {
        "acceptance_length": { "type": "number" },
        "acceptance_at_pos": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 1
        },
        "num_drafts": { "type": "integer", "minimum": 0 },
        "num_draft_tokens": { "type": "integer", "minimum": 0 },
        "num_accepted_tokens": { "type": "integer", "minimum": 0 },
        "throughput_tps": { "type": "number" },
        "speedup": { "type": "number" },
        "ttft_ms": { "type": "number" },
        "itl_ms": { "type": "number" }
      },
      "additionalProperties": false
    }
  }
}
